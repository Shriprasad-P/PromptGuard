# PromptGuard Configuration

# Admin bearer token for configuration endpoints
GUARD_TOKEN=your-secret-token-here

# Injection detection threshold (0-100)
# <40: Allow, 40-69: Review (allow but flag), >=70: Block
BLOCK_THRESHOLD=70

# Database URL
DATABASE_URL=sqlite:///./promptguard.db

# Server configuration
HOST=0.0.0.0
PORT=8000
